# Keep credentials, local data, and build caches out of the Docker context
# so they cannot be copied into an image layer.
.git
.gitignore
.venv
venv
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.ipynb_checkpoints
**/.ipynb_checkpoints

.env
.env.*
secrets
secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.kdbx
id_rsa
id_dsa
id_ecdsa
id_ed25519
.streamlit/secrets.toml

data
uploads
temp
logs
*.log
*.sqlite
*.sqlite3
*.db
*.csv
*.xlsx
*.xls

models
*.gguf
*.onnx
*.pt
*.pth
*.safetensors
*.h5
*.ckpt
*.pkl
*.joblib

tests
scripts
README.md
LICENSE
requirements-dev.txt
pytest.ini
*.md
docker-compose.yml
