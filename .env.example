# Supplier Quote Extractor does not read this file.
#
# A provider API key is pasted into the sidebar after the app starts.
# It stays in that browser session's memory and is never loaded from
# the environment, from .env, or from secrets.toml.
#
# The value below is a dummy placeholder. It is not a credential.
# Copying this file to .env has no effect. .gitignore ignores .env.

EXAMPLE_NOT_A_SECRET=dummy-value-not-used-by-the-app
